{
	admin unix//opt/apps/caddy/admin.sock|0600
	# Router presents this as 443 to the world; Caddy binds a high port so it
	# needs no root. ACME TLS-ALPN-01 arrives here via that forward.
	https_port 8443
}

minecraftmap.eliastrana.no {
	reverse_proxy 127.0.0.1:8100
	encode gzip
}

arcade.eliastrana.no {
	reverse_proxy 127.0.0.1:3001
	encode gzip
}

# Pages and the /ws websocket for live games both go to the same process; Caddy upgrades websockets by itself.
jeopardy.eliastrana.no {
	reverse_proxy 127.0.0.1:3050
	encode gzip
}

canvas.eliastrana.no {
	redir https://arcade.eliastrana.no{uri} 308
}

hitster.eliastrana.no {
	@ws header Upgrade websocket
	handle @ws {
		reverse_proxy 127.0.0.1:3002
	}
	handle {
		reverse_proxy 127.0.0.1:3010
	}
	encode gzip
}

status.eliastrana.no {
	reverse_proxy 127.0.0.1:3020
	encode gzip
}

# Shared by the two cases below: the chat page (Open WebUI).
(chatpage) {
	reverse_proxy 127.0.0.1:3030 {
		flush_interval -1
		transport http {
			response_header_timeout 10m
			read_timeout 10m
		}
	}
}

llm.eliastrana.no {
	# The login page and its stylesheet are open to everyone.
	@gate path /login /logout /gate.css
	handle @gate {
		reverse_proxy 127.0.0.1:3040
	}

	# The raw Ollama API for scripts and apps, under /ollama/: still password only (browser login or HTTP Basic).
	# Chat and text generation only: anything that could download, change or delete models is refused.
	handle_path /ollama/* {
		forward_auth 127.0.0.1:3040 {
			uri /verify
		}
		@blocked path /api/pull /api/push /api/create /api/delete /api/copy /api/blobs/*
		respond @blocked 403
		request_body {
			max_size 5MB
		}
		reverse_proxy 127.0.0.1:11434 {
			# Ollama only answers requests addressed to localhost, so present the request as one.
			header_up Host localhost:11434
			flush_interval -1
			transport http {
				response_header_timeout 10m
				read_timeout 10m
			}
		}
	}

	# The chat page is open to everyone, no password. The login gate only decides WHO the visitor is to Open WebUI:
	# a valid login cookie (log in at /login) = admin, anyone else = the shared non-admin "guest".
	handle {
		route {
			# The identity headers are Caddy's to set. Never trust ones sent by the visitor.
			request_header -X-Auth-Email
			request_header -X-Auth-Role
			forward_auth 127.0.0.1:3040 {
				uri /identity
				copy_headers X-Auth-Email X-Auth-Role
			}

			# Guests: no file or knowledge uploads (Open WebUI only hides the buttons, its API would still accept them), small requests.
			@guest header X-Auth-Role user
			handle @guest {
				@noupload path /api/v1/files* /api/v1/knowledge* /api/v1/retrieval* /api/v1/audio* /api/v1/images*
				respond @noupload 403
				request_body {
					max_size 1MB
				}
				import chatpage
			}

			# Admin: room for PDF uploads up to 50 MB.
			handle {
				request_body {
					max_size 55MB
				}
				import chatpage
			}
		}
	}
}
