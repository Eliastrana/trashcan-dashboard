@@ -1 +1,269 @@
-export { default, getServerSideProps } from './api/home';
+import { useEffect, useRef, useState } from "react";
+import remarkGfm from "remark-gfm";
+
+import { CodeBlock } from "@/components/Markdown/CodeBlock";
+import { MemoizedReactMarkdown } from "@/components/Markdown/MemoizedReactMarkdown";
+
+type ChatMessage = {
+  role: "user" | "assistant";
+  content: string;
+};
+
+// How answers are drawn. react-markdown never renders raw HTML, so a model answer cannot inject markup.
+const markdownComponents = {
+  code({ className, children }: any) {
+    const match = /language-(\w+)/.exec(className || "");
+    const text = String(children).replace(/\n$/, "");
+    const isBlock = Boolean(match) || text.includes("\n");
+
+    return isBlock ? (
+      <CodeBlock language={(match && match[1]) || ""} value={text} />
+    ) : (
+      <code className="rounded-md bg-neutral-200/70 px-1.5 py-0.5 text-[0.9em] font-medium before:content-none after:content-none">
+        {children}
+      </code>
+    );
+  },
+  pre({ children }: any) {
+    return <>{children}</>;
+  },
+  a({ href, children }: any) {
+    return (
+      <a
+        href={href}
+        target="_blank"
+        rel="noopener noreferrer"
+        className="underline underline-offset-4"
+      >
+        {children}
+      </a>
+    );
+  },
+  table({ children }: any) {
+    return (
+      <div className="my-4 overflow-x-auto rounded-xl border border-neutral-200 bg-white/60">
+        <table className="m-0 w-full border-collapse text-sm">{children}</table>
+      </div>
+    );
+  },
+  th({ children }: any) {
+    return (
+      <th className="border-b border-neutral-200 px-3 py-2 text-left font-semibold">
+        {children}
+      </th>
+    );
+  },
+  td({ children }: any) {
+    return <td className="border-b border-neutral-100 px-3 py-2">{children}</td>;
+  },
+};
+
+export default function Home() {
+  const [messages, setMessages] = useState<ChatMessage[]>([]);
+  const [input, setInput] = useState("");
+  const [loading, setLoading] = useState(false);
+
+  const bottomRef = useRef<HTMLDivElement | null>(null);
+  const textareaRef = useRef<HTMLTextAreaElement | null>(null);
+
+  useEffect(() => {
+    bottomRef.current?.scrollIntoView({
+      behavior: loading ? "auto" : "smooth",
+      block: "end",
+    });
+  }, [messages, loading]);
+
+  // Let the text field grow with what is typed, up to a limit.
+  useEffect(() => {
+    const field = textareaRef.current;
+    if (!field) return;
+    field.style.height = "auto";
+    field.style.height = `${Math.min(field.scrollHeight, 160)}px`;
+  }, [input]);
+
+  async function sendMessage() {
+    const question = input.trim();
+    if (!question || loading) return;
+
+    setInput("");
+    setLoading(true);
+
+    const assistantIndex = messages.length + 1;
+
+    setMessages((prev) => [
+      ...prev,
+      { role: "user", content: question },
+      { role: "assistant", content: "" },
+    ]);
+
+    const update = (change: (content: string) => string) =>
+      setMessages((prev) =>
+        prev.map((msg, index) =>
+          index === assistantIndex ? { ...msg, content: change(msg.content) } : msg
+        )
+      );
+
+    try {
+      const response = await fetch("/api/web-gemma", {
+        method: "POST",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({ question }),
+      });
+
+      if (!response.ok || !response.body) {
+        throw new Error("Klarte ikke å kontakte serveren.");
+      }
+
+      const reader = response.body.getReader();
+      const decoder = new TextDecoder();
+      let buffer = "";
+
+      while (true) {
+        const { value, done } = await reader.read();
+        if (done) break;
+
+        buffer += decoder.decode(value, { stream: true });
+
+        const lines = buffer.split("\n");
+        buffer = lines.pop() || "";
+
+        for (const line of lines) {
+          if (!line.trim()) continue;
+
+          const event = JSON.parse(line);
+
+          if (event.type === "token") {
+            update((content) => content + event.token);
+          }
+
+          if (event.type === "error") {
+            update(() => `Feil: ${event.error}`);
+          }
+        }
+      }
+    } catch (err: any) {
+      update(() => `Feil: ${err.message || "Klarte ikke å svare."}`);
+    } finally {
+      setLoading(false);
+    }
+  }
+
+  function handleKeyDown(e: React.KeyboardEvent<HTMLTextAreaElement>) {
+    if (e.key === "Enter" && !e.shiftKey) {
+      e.preventDefault();
+      sendMessage();
+    }
+  }
+
+  return (
+    <main className="relative min-h-screen bg-neutral-100 text-neutral-900">
+      {/* Soft colour behind everything, so the glass below has something to blur. */}
+      <div aria-hidden className="pointer-events-none fixed inset-0 overflow-hidden">
+        <div className="absolute -left-24 top-8 h-80 w-80 rounded-full bg-sky-200/60 blur-3xl" />
+        <div className="absolute -right-24 top-1/3 h-96 w-96 rounded-full bg-violet-200/50 blur-3xl" />
+        <div className="absolute bottom-0 left-1/4 h-80 w-80 rounded-full bg-rose-200/50 blur-3xl" />
+      </div>
+
+      <div className="relative mx-auto flex min-h-screen w-full max-w-3xl flex-col px-4">
+        <section className="flex-1 space-y-8 pb-44 pt-10">
+          {messages.length === 0 && (
+            <div className="flex h-[55vh] items-center justify-center text-center">
+              <p className="text-xl font-medium tracking-tight text-neutral-400">
+                Hva kan jeg hjelpe med?
+              </p>
+            </div>
+          )}
+
+          {messages.map((msg, index) => {
+            if (msg.role === "user") {
+              return (
+                <article key={index} className="flex justify-end">
+                  <div className="max-w-[88%] rounded-2xl bg-neutral-200/80 px-4 py-3 text-[15px] leading-7">
+                    <div className="whitespace-pre-wrap">{msg.content}</div>
+                  </div>
+                </article>
+              );
+            }
+
+            const streaming = loading && index === messages.length - 1;
+
+            return (
